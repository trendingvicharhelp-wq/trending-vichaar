# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/trending-vichaar

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# Public site URL (used in sitemap, OG tags, published-post links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@trendingvichaar.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# ─────────────────────────────────────────────────────────────
# AI Content Agent (lib/agents)
# ─────────────────────────────────────────────────────────────

# REQUIRED — Anthropic API key for the content pipeline
ANTHROPIC_API_KEY=sk-ant-...

# REQUIRED to trigger /api/agent/run — shared secret (any long random string).
# Vercel Cron can also use CRON_SECRET instead.
AGENT_TRIGGER_SECRET=replace-with-a-long-random-string

# Optional — override the model split (defaults shown)
# AGENT_MODEL_WRITER=claude-opus-4-8
# AGENT_MODEL_RESEARCH=claude-sonnet-4-6
# AGENT_MODEL_SEO=claude-sonnet-4-6
# AGENT_MODEL_UTILITY=claude-haiku-4-5

# Optional — schedule (self-hosted cron). Default 21:00 in Asia/Kolkata.
# AGENT_CRON=0 21 * * *

# Optional — author identity on published posts
# AGENT_AUTHOR_NAME=Trending Vichaar
# AGENT_AUTHOR_BIO=The Trending Vichaar editorial desk.

# Optional — web search tool version (override only if your account pins one)
# AGENT_WEB_SEARCH_TOOL=web_search_20260209

# Optional — set to 1 for verbose per-step token/usage logging
# AGENT_DEBUG=1
